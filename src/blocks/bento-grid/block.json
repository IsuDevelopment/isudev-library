{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "isudev/bento-grid",
	"version": "1.0.0",
	"title": "Bento Grid",
	"category": "design",
	"icon": "grid-view",
	"description": "A mosaic of tiles in different sizes, arranged separately for desktop, tablet and mobile.",
	"keywords": ["bento", "grid", "layout"],
	"textdomain": "isudev-library",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"columns": {
			"type": "object",
			"default": { "desktop": 6, "tablet": 4, "mobile": 2 }
		},
		"gap": {
			"type": "object",
			"default": { "desktop": "16", "tablet": "12", "mobile": "8" }
		},
		"minCardHeight": { "type": "number", "default": 150 },
		"hasChosenVariation": { "type": "boolean", "default": false }
	},
	"allowedBlocks": ["isudev/bento-card"],
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
