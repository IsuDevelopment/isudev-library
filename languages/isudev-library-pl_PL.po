#: extensions/accessibility-statement-page/hooks.php:516
#, php-format
msgid "The selected accessibility statement page is in the Trash. Create or select another page, or <a href=\"%s\">restore it</a>."
msgstr "Wybrana strona deklaracji dostępności jest w koszu. Utwórz lub wybierz inną stronę albo <a href=\"%s\">przywróć ją</a>."

#: extensions/accessibility-statement-page/hooks.php:523
msgid "Choose the page that holds your accessibility statement, or create a draft from a template and complete it. Link to it from every page, usually in the footer."
msgstr "Wybierz stronę z deklaracją dostępności albo utwórz szkic z szablonu i uzupełnij go. Umieść link do niej na każdej stronie, zwykle w stopce."

