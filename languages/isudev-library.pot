#: extensions/button-color/extension.php:14
msgid "Button colour for outline and link styles"
msgstr ""

#: extensions/button-color/extension.php:15
msgid "Exposes the colour picked on a Button block as a CSS custom property, in the editor and on the site, so a theme can draw outline and text-only buttons (and their icons) in that colour. Also removes core's Outline style, which turns into a filled button as soon as a colour is picked."
msgstr ""

#: extensions/button-icon/extension.php:14
#: build/extensions/button-icon/editor.js:1
#: extensions/button-icon/src/editor.js:368
msgid "Button icon"
msgstr ""

#: extensions/button-icon/extension.php:15
msgid "Lets editors put an icon from the library's icon set before or after the text of a Button block, choose its size, or show the icon alone with the text kept for screen readers."
msgstr ""

#: extensions/core-accordion-custom-icons/extension.php:14
msgid "Accordion toggle icons"
msgstr ""

#: extensions/core-accordion-custom-icons/extension.php:15
msgid "Replaces the \"+\" on the core Accordion block with an icon from the icon library, one for closed and one for open items. Editors pick the icons and their size per accordion; the theme sets the defaults."
msgstr ""

#: extensions/core-accordion-faq-schema/extension.php:14
msgid "Accordion FAQ structured data"
msgstr ""

#: extensions/core-accordion-faq-schema/extension.php:15
msgid "Adds a switch to the core Accordion block that publishes its questions and answers as FAQPage structured data (JSON-LD), through Yoast SEO or Rank Math when one is active, or on its own otherwise."
msgstr ""

#: extensions/core-accordion-hash-navigation/extension.php:14
msgid "Accordion links"
msgstr ""

#: extensions/core-accordion-hash-navigation/extension.php:15
msgid "Gives every core Accordion item a stable, readable link (#question-title, or the heading's HTML anchor). Opening an item puts its link in the address bar, and visiting a link opens and scrolls to that item."
msgstr ""

#: extensions/disable-application-passwords/extension.php:14
msgid "Disable application passwords"
msgstr ""

#: extensions/disable-application-passwords/extension.php:15
msgid "Switches application passwords off: the profile section disappears and existing application passwords stop authenticating REST API and XML-RPC requests. Breaks apps and integrations that sign in with one."
msgstr ""

#: extensions/disable-block-directory/extension.php:14
msgid "Disable the block directory"
msgstr ""

#: extensions/disable-block-directory/extension.php:15
msgid "Stops the block inserter from suggesting and installing blocks from WordPress.org, and closes the block directory search endpoint. Plugins can still be installed from Plugins → Add New."
msgstr ""

#: extensions/disable-comments/extension.php:14
msgid "Disable comments"
msgstr ""

#: extensions/disable-comments/extension.php:15
msgid "Turns comments and pingbacks off site-wide: closes them on every post type, hides existing ones and removes Comments from the admin."
msgstr ""

#: extensions/disable-comments/hooks.php:283
msgid "Comments are closed."
msgstr ""

#: extensions/disable-custom-css/extension.php:14
msgid "Disable custom CSS"
msgstr ""

#: extensions/disable-custom-css/extension.php:15
msgid "Takes CSS out of editors' hands: removes Additional CSS from the Customizer, Global Styles and the block settings, and stops CSS already saved there from loading. CSS shipped by the theme keeps working."
msgstr ""

#: extensions/disable-emoji/extension.php:14
msgid "Disable emoji images"
msgstr ""

#: extensions/disable-emoji/extension.php:15
msgid "Stops WordPress from replacing emoji with images from WordPress.org: removes the detection script and its styles from every page, the admin and embeds. Emoji still show, drawn by the visitor's own system font."
msgstr ""

#: extensions/disable-feeds/extension.php:14
msgid "Disable feeds"
msgstr ""

#: extensions/disable-feeds/extension.php:15
msgid "Switches off every RSS, RDF and Atom feed, including comment feeds: feed URLs answer with the theme's 404 page and the feed links leave the page head."
msgstr ""

#: extensions/disable-fit-text/extension.php:14
msgid "Disable fit text"
msgstr ""

#: extensions/disable-fit-text/extension.php:15
msgid "Removes the \"Fit text\" typography option, which scales a heading or paragraph to fill its container with JavaScript and ignores the theme's font sizes. Blocks saved with it render at their normal size again."
msgstr ""

#: extensions/disable-openverse/extension.php:14
msgid "Disable Openverse"
msgstr ""

#: extensions/disable-openverse/extension.php:15
msgid "Removes the Openverse tab from the block inserter's Media section, so editors pick images from the Media Library only instead of hotlinking free-licence images from openverse.org."
msgstr ""

#: extensions/disable-posts/extension.php:14
msgid "Disable posts"
msgstr ""

#: extensions/disable-posts/extension.php:15
msgid "Switches off the built-in Posts post type with its categories and tags: no admin menu, every post URL, archive and posts feed answers 404, and posts leave REST, XML-RPC, sitemaps and the block inserter. Set a static homepage first."
msgstr ""

